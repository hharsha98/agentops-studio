# FreeLLMAPI stays external (optional). Deterministic studio demo works without it.
MODEL_BASE_URL=http://localhost:3001/v1
MODEL_API_KEY=
MODEL_NAME=auto
PUBLIC_DEMO_MODE=true
FORCE_DETERMINISTIC=true

# Local API / web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Knowledge fixtures (repo-root relative from where you launch Compose;
# when running uvicorn from apps/api use ../../demo-data or an absolute path)
DEMO_DATA_DIR=../../demo-data

# Data stores (Compose defaults — available for future persistence; demo runs in-memory today)
DATABASE_URL=postgresql://agentops:agentops@localhost:5432/agentops
REDIS_URL=redis://localhost:6379/0
SEARXNG_URL=http://localhost:8080

# Future private action integrations (sandbox-only in public demo)
GITHUB_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SLACK_BOT_TOKEN=

# Optional observability export (internal traces always work without Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3005
