# FreeLLMAPI stays external (optional). Deterministic studio demo works without it.
MODEL_BASE_URL=http://localhost:3001/v1
MODEL_API_KEY=
MODEL_NAME=auto
PUBLIC_DEMO_MODE=true
# Seed an approval run and a finished run at API startup so the first visit is not empty.
DEMO_PUBLIC=true
FORCE_DETERMINISTIC=true

# Browser calls same-origin /api. Next.js (or Caddy) proxies that to the API.
# Set PUBLIC_API_ORIGIN only when the API is on another host, then rebuild the web app.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_BASE_URL=/api

# Runtime proxy target inside the Next.js server. Not baked into the client bundle.
# Dev API is :8000. Production scripts override this to :8010.
API_PROXY_TARGET=http://127.0.0.1:8000

# Direct browser calls to the API (split origin). Same-origin /api does not need CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010,https://agentops.169.58.185.43.sslip.io,http://agentops.169.58.185.43.sslip.io
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Knowledge fixtures (repo-root relative from where you launch Compose;
# when running uvicorn from apps/api use ../../demo-data or an absolute path)
DEMO_DATA_DIR=../../demo-data

# Data stores (Compose defaults — available for future persistence; demo runs in-memory today)
DATABASE_URL=postgresql://agentops:agentops@localhost:5432/agentops
REDIS_URL=redis://localhost:6379/0
SEARXNG_URL=http://localhost:8080

# Future private action integrations (sandbox-only in public demo)
GITHUB_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SLACK_BOT_TOKEN=

# Optional observability export (internal traces always work without Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3005
